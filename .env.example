# ============================================
# Inventory Management System - Environment Variables
# ============================================

# ---------- Application ----------
APP_ENV=development
LOG_LEVEL=debug
SERVER_PORT=8080
IDEMPOTENCY_TTL=5m

# ---------- Rate Limiting ----------
RATE_LIMIT=100
RATE_LIMIT_WINDOW=1s

# ---------- Stock Cache ----------
STOCK_CACHE_TTL=5m

# ---------- PostgreSQL ----------
DB_HOST=postgres
DB_PORT=5432
DB_USER=inventory
DB_PASS=inventory
DB_NAME=inventory
DB_SSLMODE=disable
DB_MAX_CONNS=10

# ---------- Redis ----------
REDIS_HOST=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- ClickHouse ----------
CLICKHOUSE_HOST=clickhouse:9000
CLICKHOUSE_USER=inventory
CLICKHOUSE_PASS=inventory
CLICKHOUSE_DB=analytics

# ---------- Kafka ----------
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=stock-events
KAFKA_GROUP=stock-worker-group

# ---------- Infrastructure ----------
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=inventory
CLICKHOUSE_PASSWORD=inventory

# ---------- Grafana ----------
GRAFANA_PASSWORD=admin